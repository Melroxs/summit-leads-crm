{
  "name": "ai-sales-crm-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @crm/api\" \"npm run dev --workspace @crm/web\"",
    "dev:api": "npm run dev --workspace @crm/api",
    "dev:web": "npm run dev --workspace @crm/web",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
